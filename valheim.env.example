# Copie este arquivo para valheim.env e defina uma senha antes de iniciar.
SERVER_NAME=Raiz do Norte
WORLD_NAME=raiz_do_norte
SERVER_PASS=troque-por-uma-senha-segura
SERVER_PUBLIC=true
CROSSPLAY=true
TZ=America/Bahia
BACKUPS=true
BACKUPS_MAX_AGE=7
UPDATE_IF_IDLE=true
RESTART_CRON="10 5 * * *"
RESTART_IF_IDLE=true
STATUS_HTTP=true
STATUS_HTTP_PORT=80

